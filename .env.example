# MNB Translation Gateway - example configuration (Phase 05-B2.1)
# Copy to .env for local use. NEVER put real secrets in this file.
# .env is git-ignored. Node does not load .env automatically; use
#   node --env-file=.env src/index.js
# or export the variables in your shell / hosting dashboard.

# development | test | production   (default: development)
NODE_ENV=development

# TCP port. REQUIRED when NODE_ENV=production (hosting platforms inject it).
# Optional in development (default 8080).
PORT=8080

# Bind address. Default: 127.0.0.1 (development), 0.0.0.0 (production).
# HOST=127.0.0.1

# silent | error | warn | info | debug
# LOG_LEVEL=debug

# Request limits (integers). Defaults shown.
# MAX_BODY_BYTES=1048576
# REQUEST_TIMEOUT_MS=30000
# MAX_TEXT_CHARS=20000

# ---------------------------------------------------------------------------
# Phase 05-B2.1: client authentication (Bearer token)
# Clients must send:  Authorization: Bearer <token>   (POST /v1/translate)
# REQUIRED when NODE_ENV=production: the server refuses to start without it.
# Optional in development/test: when empty, authentication is NOT enforced.
# Printable ASCII, no spaces. Set the real value ONLY in the hosting dashboard
# (as a secret) or in your local, git-ignored .env file. Leave empty here.
# ---------------------------------------------------------------------------
GATEWAY_CLIENT_TOKEN=

# ---------------------------------------------------------------------------
# Reserved for LATER phases. Not read yet.
# Leave empty here. Set real values ONLY in the hosting dashboard
# (as a secret) or in your local, git-ignored .env file.
# ---------------------------------------------------------------------------
# GEMINI_API_KEY=
