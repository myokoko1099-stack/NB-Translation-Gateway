# MNB Translation Gateway - example configuration (Phase 05-B2.3)
# Copy to .env for local use. NEVER put real secrets in this file.
# .env is git-ignored. Node does not load .env automatically; use
#   node --env-file=.env src/index.js
# or export the variables in your shell / hosting dashboard.

# development | test | production   (default: development)
NODE_ENV=development

# TCP port. REQUIRED when NODE_ENV=production (hosting platforms inject it).
# Optional in development (default 8080).
PORT=8080

# Bind address. Default: 127.0.0.1 (development), 0.0.0.0 (production).
# HOST=127.0.0.1

# silent | error | warn | info | debug
# Phase 05-B4: NODE_ENV=production refuses to start with LOG_LEVEL=debug.
# LOG_LEVEL=debug

# Request limits (integers). Defaults shown.
# MAX_BODY_BYTES=1048576
# REQUEST_TIMEOUT_MS=30000
# MAX_TEXT_CHARS=20000

# ---------------------------------------------------------------------------
# Phase 05-B2.1: client authentication (Bearer token)
# Clients must send:  Authorization: Bearer <token>   (POST /v1/translate)
# REQUIRED when NODE_ENV=production: the server refuses to start without it.
# Optional in development/test: when empty, authentication is NOT enforced.
# Printable ASCII, no spaces. Set the real value ONLY in the hosting dashboard
# (as a secret) or in your local, git-ignored .env file. Leave empty here.
# Phase 05-B4: in production the server also refuses to start when the token is
# a placeholder (for example changeme, <...> or ${...}), shorter than 16
# characters, or one single repeated character. Use a long random value.
# ---------------------------------------------------------------------------
GATEWAY_CLIENT_TOKEN=

# ---------------------------------------------------------------------------
# Phase 05-B2.2: rate limiting (POST /v1/translate, per client IP, in memory,
# single instance only). Defaults shown; invalid values stop startup.
# ---------------------------------------------------------------------------
# Max requests per client per window (1 - 100000).
# GATEWAY_RATE_LIMIT_MAX=60
# Window length in milliseconds (1000 - 3600000).
# GATEWAY_RATE_LIMIT_WINDOW_MS=60000
# Number of trusted reverse proxies in front of this server (0 - 10).
# 0 = never trust X-Forwarded-For (use the TCP peer address). Set to N ONLY if
# exactly N trusted proxies sit in front AND the server is reachable only
# through them; otherwise clients could spoof their IP.
# GATEWAY_TRUSTED_PROXY_HOPS=0

# ---------------------------------------------------------------------------
# Phase 05-B2.3: CORS allowlist (browser clients only)
# Comma-separated list of exact origins that may call this API from a browser.
# Format per entry: scheme://host[:port]  (http or https, lowercase, NO path,
# NO trailing slash, NO wildcard "*", NO "null"). Up to 50 entries.
# Example:
#   GATEWAY_CORS_ALLOWED_ORIGINS=https://app.example.com,http://localhost:3000
#
# Empty / unset (default) = NO browser origin is accepted. Requests that carry
# an Origin header get 403 ORIGIN_NOT_ALLOWED; requests WITHOUT an Origin
# header (the native Android app, curl, server-to-server) are not affected.
# An invalid entry stops startup with an error naming this variable only.
# This is not a secret, but keep real production origins in the hosting
# dashboard rather than in this file.
# ---------------------------------------------------------------------------
# GATEWAY_CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Phase 05-B3: translation provider
# none   (default) = no provider; POST /v1/translate answers 501 NOT_IMPLEMENTED.
#                    The GEMINI_* variables below are not read or checked.
# gemini           = Gemini Interactions API. GEMINI_API_KEY is then REQUIRED and
#                    any invalid GEMINI_* value stops startup (variable name only
#                    is reported, never its value).
# The key is used on the server only. NEVER put it in the Android app, in this
# file, or in Git. Set the real value ONLY in the hosting dashboard (as a
# secret) or in your local, git-ignored .env file. Leave it empty here.
# ---------------------------------------------------------------------------
TRANSLATION_PROVIDER=none
GEMINI_API_KEY=
# Model id used for every Gemini request (default shown).
# GEMINI_MODEL=gemini-3.1-flash-lite
# Upstream request timeout in milliseconds (1000 - 120000). A timeout is
# answered with 504 UPSTREAM_TIMEOUT; there is no automatic retry.
# GEMINI_TIMEOUT_MS=30000
