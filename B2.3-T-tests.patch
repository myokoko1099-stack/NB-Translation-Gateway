+  });
+});
+
+/* ------------------------------------------------------------------ */
+describe('regression - the translation provider is never called for a rejected request', () => {
+  it('403, 401, 404, 405, 415, 413, 408, 400, 204 and 429 leave the provider untouched', async () => {
