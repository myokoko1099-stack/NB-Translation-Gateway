+      await postJsonRaw(srv.baseUrl, VALID, bearer());
+      assert.equal(rateLimiter.size(), 1);
+    });
+  });
+});
+
+/* ------------------------------------------------------------------ */
+describe('regression - pipeline order: Origin -> Auth -> Rate limit -> Body', () => {
